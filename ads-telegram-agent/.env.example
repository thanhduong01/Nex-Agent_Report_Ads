# Copy to .env.local. Keep secrets out of Git and chat messages.
SEND_REPORTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paste the service account JSON as one line inside single quotes, OR set
# GOOGLE_APPLICATION_CREDENTIALS to its absolute path for local development.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional. Force authenticated Sheets API even for the two existing shared links.
SHEETS_REQUIRE_AUTH=false

# Add one entry per month, or use the dashboard to register your Sheets.
# REPORT_SOURCES_JSON='{"2026-12":{"spreadsheetId":"REPLACE_WITH_DECEMBER_FILE_ID"}}'
REPORT_SOURCES_JSON={}

# Durable delivery history, required when sending (not needed for previews).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional AI analysis. Vercel deployment can use project OIDC for AI Gateway.
AI_ENABLED=false
REPORT_MODEL=openai/gpt-6-luna-fast
AI_GATEWAY_API_KEY=
