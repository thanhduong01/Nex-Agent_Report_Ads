{
  "name": "ads-telegram-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.ts",
    "demo": "node scripts/report.ts --demo --date 2026-11-02",
    "report": "node --env-file-if-exists=.env.local scripts/report.ts",
    "send": "node --env-file-if-exists=.env.local scripts/report.ts --send",
    "telegram:preview": "node --env-file-if-exists=.env.local scripts/report.ts --telegram-preview",
    "telegram:chat": "node --env-file-if-exists=.env.local scripts/telegram-chat.ts",
    "ui": "node --env-file-if-exists=.env.local scripts/dashboard/server.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "^2.8.0",
    "ai": "^7.0.137",
    "eve": "^1.0.0-rc.2",
    "google-auth-library": "^11.3.2",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/blob": {
      "@vercel/oidc": {
        "@vercel/cli-config": "^0.3.6"
      }
    }
  }
}
